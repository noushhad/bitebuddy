<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ✅ Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Only Android 13+ shows a runtime dialog for this -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ℹ️ Avoid legacy storage unless you truly need it; scoped storage is preferred -->
    <!-- <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" /> -->
    <!-- <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" /> -->

    <application
        android:name="${applicationName}"
        android:label="BiteBuddy"
        android:icon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="true">

        <!-- ✅ Google Maps / Places API Keys (use the same key unless you split them) -->
        <!-- Set the real value via Gradle manifestPlaceholders (see notes below) -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyCoQzkmzecrFnHY1vSeJiRdiG4YILWKK2Y" />

        <!-- Required if you use Places SDK (autocomplete, place details, etc.) -->
        <meta-data
            android:name="com.google.android.libraries.places.API_KEY"
            android:value="AIzaSyCoQzkmzecrFnHY1vSeJiRdiG4YILWKK2Y" />

        <!-- (Optional) GoMaps Pro – only if you actually use it and prefer meta-data storage
        <meta-data
            android:name="gomaps.pro.API_KEY"
            android:value="${GOMAPS_PRO_KEY}" />
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- Optional queries example -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
</manifest>
